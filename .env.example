# Copy to .env and fill in. .env is gitignored — keep it that way.
# This project is read-only by design. There is no wallet key here and there
# should never be one. If you find yourself adding one, you are building a
# different (and much riskier) project.

# --- Solana data -----------------------------------------------------------
# Helius LaserStream: Yellowstone-compatible gRPC with 24h replay and failover.
# Mainnet gRPC requires a paid plan; devnet works on the free Developer tier.
# For a zero-cost start, set INGEST_SOURCE=pumpportal and skip these two.
HELIUS_API_KEY=
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com

# Plain RPC, used for metadata fetches and mint/freeze authority checks.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# laserstream | pumpportal
# pumpportal is a free public WebSocket of pump.fun events. Good enough to build
# and tune against; higher latency and no replay, so move to laserstream once
# the pipeline works.
INGEST_SOURCE=pumpportal
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# --- Enrichment ------------------------------------------------------------
BIRDEYE_API_KEY=
# DexScreener needs no key but is rate limited. Cache aggressively.

# --- Infra -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://argus:argus@localhost:5432/argus
GATEWAY_PORT=8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Config files ----------------------------------------------------------
# Where thresholds.yml and kol-wallets.json live. Both are hot-reloaded; a
# config change should never require a redeploy.
ARGUS_CONFIG_DIR=./config
