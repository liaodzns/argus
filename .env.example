# Copy to .env and fill in. .env is gitignored — keep it that way.
# This project is read-only by design. There is no wallet key here and there
# should never be one. If you find yourself adding one, you are building a
# different (and much riskier) project.

# --- Solana data -----------------------------------------------------------
# The only value you actually need to start. Helius' free Developer tier covers
# mainnet standard RPC and WebSockets, which is what INGEST_SOURCE=helius_logs
# uses. No funded wallet, no signing, no custody.
HELIUS_API_KEY=

# helius_logs | laserstream
# helius_logs subscribes to program logs and fetches each matching transaction
# for its balance deltas. That is one RPC round trip per candidate transaction,
# which is the known cost of starting without a paid plan.
# laserstream streams whole transactions over gRPC and removes that round trip.
# It needs a paid plan for mainnet and lands at step 10.
INGEST_SOURCE=helius_logs

# Both default to the Helius mainnet endpoints built from HELIUS_API_KEY.
# Set them only to point at a different provider.
SOLANA_RPC_URL=
SOLANA_WS_URL=

# Required when INGEST_SOURCE=laserstream.
LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com

# --- What to watch ---------------------------------------------------------
# The wallet Argus watches. For Axiom this is its TRADING wallet, not your
# funding wallet — the trading wallet is what signs the swaps. Public address,
# so this is not a secret, but it is yours, so it lives in .env and not in the
# repository.
WATCHED_WALLET=

# --- Enrichment ------------------------------------------------------------
BIRDEYE_API_KEY=
# DexScreener needs no key but is rate limited. Cache aggressively.

# --- Infra -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://argus:argus@localhost:5432/argus
GATEWAY_PORT=8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Config files ----------------------------------------------------------
# Where thresholds.yml and kol-wallets.json live. Both are hot-reloaded; a
# config change should never require a redeploy.
ARGUS_CONFIG_DIR=./config
